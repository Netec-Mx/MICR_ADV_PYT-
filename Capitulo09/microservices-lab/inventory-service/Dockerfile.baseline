# Same source, Python version, Debian release and dependency lock as optimized.
ARG BASE_IMAGE=python:3.12.14-bookworm
FROM $BASE_IMAGE
ARG REQUIREMENTS_LOCK=requirements-baseline-lock.txt
COPY inventory-service/${REQUIREMENTS_LOCK} /tmp/requirements-lock.txt
RUN python -m pip install --no-cache-dir --only-binary=:all: -r /tmp/requirements-lock.txt && python -m pip check
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONFAULTHANDLER=1
ARG APP_VERSION=9.0.0
ENV APP_VERSION=$APP_VERSION
LABEL org.opencontainers.image.title="inventory-service" org.opencontainers.image.version="$APP_VERSION"
RUN groupadd --gid 10001 appgroup && useradd --uid 10001 --gid 10001 --no-create-home appuser
WORKDIR /app
COPY shared/ ./shared/
COPY inventory-service/app/ ./app/
USER 10001:10001
EXPOSE 8002
CMD ["python", "-m", "shared.vault.launcher", "--port", "8002"]
