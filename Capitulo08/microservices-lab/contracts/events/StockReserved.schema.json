          "type": "string"
        },
        "quantity_reserved": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Quantity Reserved",
          "type": "integer"
        },
        "remaining_stock": {
          "minimum": 0,
          "title": "Remaining Stock",
          "type": "integer"
        },
        "reservation_id": {
          "format": "uuid4",
          "title": "Reservation Id",
          "type": "string"
        }
      },
      "required": [
        "product_id",
        "quantity_reserved",
        "remaining_stock",
        "reservation_id"
      ],
      "title": "ReservedItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "format": "uuid4",
      "title": "Event Id",
      "type": "string"
    },
    "event_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "enum": [
        "1.0.0"
      ],
      "title": "Event Version",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "correlation_id": {
      "format": "uuid4",
      "title": "Correlation Id",
      "type": "string"
    },
    "event_type": {
      "const": "StockReserved",
